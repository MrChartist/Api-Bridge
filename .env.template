# 🌉 Mr. Chartist API Bridge Configuration
# ───────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# For production (VPS) deployment:
#   1. Set NODE_ENV=production
#   2. Set DHAN_MOCK=false (and other *_MOCK vars)
#   3. Set WEBHOOK_SECRET to a strong random string
#   4. Set ALLOWED_ORIGINS to your frontend domains
#   5. Set REQUIRE_AUTH=true and a strong INTERNAL_API_KEY
#   6. Run: npm run start:prod

# ═══ ENVIRONMENT ═══
NODE_ENV=development        # development | production

# ═══ ACTIVE BROKER ═══
# Set to: dhan | angel | fyers | zerodha
ACTIVE_BROKER=dhan

# ═══ Dhan Credentials ═══
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token
DHAN_MOCK=true

# ═══ AngelOne (SmartAPI) ═══
ANGEL_CLIENT_CODE=your_client_code
ANGEL_API_KEY=your_api_key
ANGEL_ACCESS_TOKEN=your_access_token
ANGEL_MOCK=true

# ═══ Fyers (v3) ═══
FYERS_APP_ID=your_app_id
FYERS_ACCESS_TOKEN=your_access_token
FYERS_MOCK=true

# ═══ Zerodha (Kite Connect) ═══
ZERODHA_API_KEY=your_api_key
ZERODHA_ACCESS_TOKEN=your_access_token
ZERODHA_MOCK=true

# ═══ System Settings ═══
PORT=4500
WS_PORT=4501

# ═══ Security ═══
# API key auth — set REQUIRE_AUTH=true to enforce X-API-Key header on all /api/* endpoints
REQUIRE_AUTH=false
JWT_SECRET=change_me_to_random_string
INTERNAL_API_KEY=mc_internal_bridge_default

# Webhook secret (if set, all webhooks must include this)
# Send via X-Webhook-Secret header or ?secret= query param
WEBHOOK_SECRET=

# CORS origin whitelist (comma-separated)
# In production, restrict to your frontends. Example:
#   ALLOWED_ORIGINS=https://optionsdesk.mrchartist.com,https://scanner.mrchartist.com
# Leave empty to allow all origins (not recommended for production)
ALLOWED_ORIGINS=

# ═══ Monitoring ═══
# Telegram alerts for VPS deployment (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
