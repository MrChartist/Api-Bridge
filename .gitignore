# Dependencies (no trailing slash: a symlinked node_modules in a worktree must be ignored too)
node_modules
node_modules/


# Environment
.env
.env.local

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite

# Instrument cache CSVs
data/*.csv

# Logs
logs/
*.log
npm-debug.log*
error.txt
stdout.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build
dist/

# Test output
coverage/

# Bridge runtime state (keys, encrypted secrets, audit log, caches) and the local config
/data/
/bridge.config.json

# Instrument-master caches written by broker adapters during tests and local runs
.cache/

# Python build and test output
build/
*.egg-info/
__pycache__/
.pytest_cache/

# Master keys and local secrets (mc-bridge init keeps the master key outside the repo; never commit one)
master.key
*.key
/secrets/
.env.*
.ccr-ca.crt

# Screenshot work files (only the .webp files in docs/screenshots are committed)
docs/screenshots/*.png

# Packed SDK tarballs (npm pack)
*.tgz

# Bridge runtime files if dataDir or MCB_HOME is pointed somewhere inside the checkout
# (the defaults are ./data, ~/.mc-bridge and ~/.config/mc-bridge/master.key)
secrets.enc
/.mc-bridge/
*.pem

# Python virtual environments (the README creates .venv in the repository folder)
.venv/
venv/

# Local output of `mc-bridge openai-tools > tools.json` from the README
/tools.json

# Private Node.js downloaded by the installer and the start-mac.command / start-linux.sh launchers
/runtime/

# Merge leftovers
*.orig

# v2 (the runtime data dir is /data/ above; server/bridge/reference/data holds shipped datasets and must be tracked)
.codegraph/
.claude/
