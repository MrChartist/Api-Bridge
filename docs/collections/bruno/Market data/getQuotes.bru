meta {
  name: Full quotes for up to 200 symbols
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/quotes?symbols=NSE:RELIANCE,NSE:NIFTY
  body: none
  auth: bearer
}

params:query {
  symbols: NSE:RELIANCE,NSE:NIFTY
  ~backup: false
  ~purpose: display
  ~account: demo-paper
  ~maxAgeMs: 0
  ~swr: false
  ~priority: interactive
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Full quotes for up to 200 symbols

  - An API key with the `read` scope (any key).

  Reference: docs/api/market-data/getQuotes.md in the repository.
}
