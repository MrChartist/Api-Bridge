meta {
  name: Change a rule
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/v1/recordings/rules/:ruleId
  body: json
  auth: bearer
}

params:path {
  ruleId: {{ruleId}}
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "enabled": false
  }
}

docs {
  Change a rule

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Only the fields sent change. A rule written in the config file is refused with 409.

  Reference: docs/api/recordings/patchRecordingRule.md in the repository.
}
