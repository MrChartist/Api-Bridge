meta {
  name: Pause a recording
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/recordings/:recordingId/pause
  body: none
  auth: bearer
}

params:path {
  recordingId: {{recordingId}}
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Pause a recording

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Reference: docs/api/recordings/pauseRecording.md in the repository.
}
