meta {
  name: The day files of a recording
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/v1/recordings/:recordingId/files
  body: none
  auth: bearer
}

params:path {
  recordingId: {{recordingId}}
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  The day files of a recording

  - An API key with the `read` scope (any key).

  One file per symbol per IST trading day, named YYYY-MM-DD__EXCHANGE_SYMBOL.csv (or .jsonl; .gz after compression). The layout is in docs/guides/recording.md.

  Reference: docs/api/recordings/listRecordingFiles.md in the repository.
}
