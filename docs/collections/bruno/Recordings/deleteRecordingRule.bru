meta {
  name: Delete a rule (its files stay unless deleteFiles=true)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/v1/recordings/rules/:ruleId
  body: none
  auth: bearer
}

params:query {
  ~deleteFiles: false
}

params:path {
  ruleId: {{ruleId}}
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Delete a rule (its files stay unless deleteFiles=true)

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Reference: docs/api/recordings/deleteRecordingRule.md in the repository.
}
