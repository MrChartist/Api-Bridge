meta {
  name: Delete a collection
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/collections/:name
  body: none
  auth: bearer
}

params:query {
  ~force: false
}

params:path {
  name: large-caps
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Delete a collection

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Refused with 409 while a download, recording or rule that is running uses it, unless `force=true`. Needs an admin key, from this computer.

  Reference: docs/api/collections/deleteCollection.md in the repository.
}
