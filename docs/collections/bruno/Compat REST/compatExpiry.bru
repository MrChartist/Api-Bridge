meta {
  name: Expiry dates
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/v1/expiry
  body: json
  auth: none
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "symbol": "NIFTY",
    "exchange": "NFO"
  }
}

docs {
  Expiry dates

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).

  Reference: docs/api/compat-rest/compatExpiry.md in the repository.
}
