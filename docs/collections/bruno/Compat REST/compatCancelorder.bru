meta {
  name: Cancel an order
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/cancelorder
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "orderid": "<orderId>"
  }
}

docs {
  Cancel an order

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).
  - Send an `Idempotency-Key` (8 to 255 characters); a retry with the same key returns the first result.

  Reference: docs/api/compat-rest/compatCancelorder.md in the repository.
}
