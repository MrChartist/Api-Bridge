meta {
  name: Quotes for up to 200 symbols
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/multiquotes
  body: json
  auth: none
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "symbols": [
      {
        "symbol": "RELIANCE",
        "exchange": "NSE"
      },
      {
        "symbol": "NIFTY",
        "exchange": "NSE_INDEX"
      }
    ]
  }
}

docs {
  Quotes for up to 200 symbols

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).

  Reference: docs/api/compat-rest/compatMultiquotes.md in the repository.
}
