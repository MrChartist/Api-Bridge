meta {
  name: Several orders in one call
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/basketorder
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "strategy": "my-script",
    "orders": [
      {
        "symbol": "RELIANCE",
        "exchange": "NSE",
        "action": "BUY",
        "quantity": 1,
        "pricetype": "MARKET",
        "product": "CNC"
      }
    ]
  }
}

docs {
  Several orders in one call

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).
  - Send an `Idempotency-Key` (8 to 255 characters); a retry with the same key returns the first result.

  Reference: docs/api/compat-rest/compatBasketorder.md in the repository.
}
