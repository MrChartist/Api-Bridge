meta {
  name: Place an order
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/placeorder
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "strategy": "my-script",
    "symbol": "RELIANCE",
    "exchange": "NSE",
    "action": "BUY",
    "quantity": 1,
    "pricetype": "MARKET",
    "product": "CNC"
  }
}

docs {
  Place an order

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).
  - The example is a paper order on the demo paper account. A live order needs every opt-in in docs/guides/safety.md.
  - Send an `Idempotency-Key` (8 to 255 characters); a retry with the same key returns the first result.

  Reference: docs/api/compat-rest/compatPlaceorder.md in the repository.
}
