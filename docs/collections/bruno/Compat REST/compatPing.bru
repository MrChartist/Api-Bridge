meta {
  name: Check the key and the account the calls act on
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ping
  body: json
  auth: none
}

body:json {
  {
    "apikey": "{{apiKey}}"
  }
}

docs {
  Check the key and the account the calls act on

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).

  Reference: docs/api/compat-rest/compatPing.md in the repository.
}
