meta {
  name: Order an option by offset (ATM, ITM2, OTM1 ...)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/optionsorder
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "strategy": "my-script",
    "underlying": "NIFTY",
    "exchange": "NSE_INDEX",
    "offset": "ATM",
    "option_type": "CE",
    "action": "BUY",
    "quantity": 75,
    "pricetype": "MARKET",
    "product": "MIS"
  }
}

docs {
  Order an option by offset (ATM, ITM2, OTM1 ...)

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).
  - Send an `Idempotency-Key` (8 to 255 characters); a retry with the same key returns the first result.

  Reference: docs/api/compat-rest/compatOptionsorder.md in the repository.
}
