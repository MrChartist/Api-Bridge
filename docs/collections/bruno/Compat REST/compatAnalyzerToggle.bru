meta {
  name: Switch analyzer mode for this key (off needs a live key)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/analyzer/toggle
  body: json
  auth: none
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "mode": true
  }
}

docs {
  Switch analyzer mode for this key (off needs a live key)

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).

  Reference: docs/api/compat-rest/compatAnalyzerToggle.md in the repository.
}
