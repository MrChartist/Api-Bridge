meta {
  name: Modify an open order
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/modifyorder
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "orderid": "<orderId>",
    "quantity": 1,
    "price": 1450,
    "pricetype": "LIMIT"
  }
}

docs {
  Modify an open order

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).
  - Send an `Idempotency-Key` (8 to 255 characters); a retry with the same key returns the first result.

  Reference: docs/api/compat-rest/compatModifyorder.md in the repository.
}
