meta {
  name: Instrument details
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/v1/symbol
  body: json
  auth: none
}

body:json {
  {
    "apikey": "{{apiKey}}",
    "symbol": "RELIANCE",
    "exchange": "NSE"
  }
}

docs {
  Instrument details

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).

  Reference: docs/api/compat-rest/compatSymbol.md in the repository.
}
