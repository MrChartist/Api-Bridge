meta {
  name: Cancel every open order
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/cancelallorder
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "apikey": "{{apiKey}}"
  }
}

docs {
  Cancel every open order

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).
  - Send an `Idempotency-Key` (8 to 255 characters); a retry with the same key returns the first result.

  Reference: docs/api/compat-rest/compatCancelallorder.md in the repository.
}
