meta {
  name: Funds
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/funds
  body: json
  auth: none
}

body:json {
  {
    "apikey": "{{apiKey}}"
  }
}

docs {
  Funds

  - Send your Bridge API key as `apikey` in the JSON body (no Authorization header).

  Reference: docs/api/compat-rest/compatFunds.md in the repository.
}
