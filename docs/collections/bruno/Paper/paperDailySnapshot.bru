meta {
  name: Take today's P&L snapshot now
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/paper/accounts/:accountId/daily
  body: none
  auth: bearer
}

params:path {
  accountId: demo-paper
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Take today's P&L snapshot now

  - An API key with the `paper` scope (or `live`).

  Marks the book to the latest prices and stores today's row. It never replaces today's end-of-day row, which it returns instead.

  Reference: docs/api/paper/paperDailySnapshot.md in the repository.
}
