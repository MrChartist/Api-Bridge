meta {
  name: Clear paper orders and positions and start again
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/paper/accounts/:accountId/reset
  body: json
  auth: bearer
}

params:path {
  accountId: demo-paper
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "startingCapital": 1000000
  }
}

docs {
  Clear paper orders and positions and start again

  - An API key with the `paper` scope (or `live`).

  Reference: docs/api/paper/resetPaperAccount.md in the repository.
}
