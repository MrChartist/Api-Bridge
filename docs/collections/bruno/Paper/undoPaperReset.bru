meta {
  name: Put back the paper book from before the last reset
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/paper/accounts/:accountId/reset/undo
  body: none
  auth: bearer
}

params:path {
  accountId: demo-paper
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Put back the paper book from before the last reset

  - An API key with the `paper` scope (or `live`).

  Works for 2 minutes after a reset and only while no order has been placed since. Orders that were pending at the reset stay cancelled.

  Reference: docs/api/paper/undoPaperReset.md in the repository.
}
