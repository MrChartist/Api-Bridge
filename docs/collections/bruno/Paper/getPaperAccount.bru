meta {
  name: Paper account summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/paper/accounts/:accountId
  body: none
  auth: bearer
}

params:path {
  accountId: demo-paper
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Paper account summary

  - An API key with the `read` scope (any key).

  Reference: docs/api/paper/getPaperAccount.md in the repository.
}
