meta {
  name: Server-Sent Events stream (same messages as the WebSocket)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/stream/sse?symbols=NSE:RELIANCE,NSE:NIFTY
  body: none
  auth: none
}

params:query {
  ~token: <hook token>
  symbols: NSE:RELIANCE,NSE:NIFTY
  ~mode: ltp
  ~orders: 1
}

docs {
  Server-Sent Events stream (same messages as the WebSocket)

  - No API key needed.

  `GET /v1/stream/sse?token=<stream token>&symbols=NSE:NIFTY,NSE:RELIANCE&mode=ltp`. Each event's `id` is its `seq`; a reconnect gets a fresh snapshot first.

  Reference: docs/api/streaming/openSse.md in the repository.
}
