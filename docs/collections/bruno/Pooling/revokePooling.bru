meta {
  name: Withdraw the pooling consent
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/pooling/consent
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Withdraw the pooling consent

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Each account serves only its own reads again.

  Reference: docs/api/pooling/revokePooling.md in the repository.
}
