meta {
  name: Release the kill switch (admin, this computer only)
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/safety/kill-switch
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "confirm": "RELEASE"
  }
}

docs {
  Release the kill switch (admin, this computer only)

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Reference: docs/api/safety/releaseKillSwitch.md in the repository.
}
