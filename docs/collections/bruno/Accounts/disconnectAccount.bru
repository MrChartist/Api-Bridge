meta {
  name: Forget the broker session (saved keys stay)
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/accounts/:accountId/session
  body: none
  auth: bearer
}

params:path {
  accountId: demo-paper
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Forget the broker session (saved keys stay)

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Reference: docs/api/accounts/disconnectAccount.md in the repository.
}
