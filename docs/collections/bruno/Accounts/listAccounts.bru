meta {
  name: Your configured accounts and their session state
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/accounts
  body: none
  auth: bearer
}

params:query {
  ~limit: 1
  ~cursor: <cursor>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Your configured accounts and their session state

  - An API key with the `read` scope (any key).

  Only accounts this key may use are listed. Never includes credentials.

  Reference: docs/api/accounts/listAccounts.md in the repository.
}
