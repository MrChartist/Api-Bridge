meta {
  name: List Telegram bots and their chats (masked)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/notify/targets
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  List Telegram bots and their chats (masked)

  - An API key with the `admin` scope.

  The bot token and chat ids are never returned: only a token hint, the bot name, a chat name and the last four digits of each chat id.

  Reference: docs/api/notifications/listNotifyTargets.md in the repository.
}
