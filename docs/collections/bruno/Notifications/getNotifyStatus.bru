meta {
  name: Notification health: queue, last delivery, last error per target
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/notify/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Notification health: queue, last delivery, last error per target

  - An API key with the `admin` scope.

  Plain-words state for the dashboard and `mc-bridge doctor`. No secrets.

  Reference: docs/api/notifications/getNotifyStatus.md in the repository.
}
