meta {
  name: Remove a chat from the list
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/v1/notify/targets/:targetId/chats/:chatKey
  body: none
  auth: bearer
}

params:path {
  targetId: <targetId>
  chatKey: <chatKey>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Remove a chat from the list

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Reference: docs/api/notifications/deleteNotifyChat.md in the repository.
}
