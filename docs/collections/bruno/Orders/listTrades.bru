meta {
  name: Executions (trade book)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/trades
  body: none
  auth: bearer
}

params:query {
  ~account: demo-paper
  ~mode: paper
  ~limit: 100
  ~cursor: <cursor>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
