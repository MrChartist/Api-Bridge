meta {
  name: Webhook subscriptions
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/subscriptions
  body: none
  auth: bearer
}

params:query {
  ~limit: 1
  ~cursor: <cursor>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Webhook subscriptions

  - An API key with the `admin` scope.

  The URL's path and the signing secret are never returned, only the host.

  Reference: docs/api/events/listSubscriptions.md in the repository.
}
