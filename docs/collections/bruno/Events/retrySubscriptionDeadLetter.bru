meta {
  name: Put a dead letter back in the queue (this computer only)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/subscriptions/:subscriptionId/dead-letters/:deliveryId/retry
  body: none
  auth: bearer
}

params:path {
  subscriptionId: {{subscriptionId}}
  deliveryId: <deliveryId>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Put a dead letter back in the queue (this computer only)

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  Reference: docs/api/events/retrySubscriptionDeadLetter.md in the repository.
}
