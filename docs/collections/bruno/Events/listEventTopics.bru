meta {
  name: The topics this key may receive
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/events/topics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  The topics this key may receive

  - An API key with the `read` scope (any key).

  A read key sees no admin-only topic. A filter may be a topic, a prefix such as `order.*`, or `*`.

  Reference: docs/api/events/listEventTopics.md in the repository.
}
