meta {
  name: Pause a queued or running job
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/downloads/:downloadId/pause
  body: none
  auth: bearer
}

params:path {
  downloadId: <downloadId>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Pause a queued or running job

  - An API key with the `read` scope (any key).

  The job keeps what it has written and continues from there when resumed.

  Reference: docs/api/data-downloads/pauseDownload.md in the repository.
}
