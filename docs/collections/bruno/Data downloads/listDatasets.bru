meta {
  name: Datasets stored on this computer
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/datasets
  body: none
  auth: bearer
}

params:query {
  ~tag: <tag>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Datasets stored on this computer

  - An API key with the `read` scope (any key).

  A dataset is a named set of files (one per symbol and interval) that grows by incremental updates.

  Reference: docs/api/data-downloads/listDatasets.md in the repository.
}
