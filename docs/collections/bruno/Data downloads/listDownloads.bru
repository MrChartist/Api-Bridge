meta {
  name: Download jobs, newest first
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/downloads
  body: none
  auth: bearer
}

params:query {
  ~status: queued
  ~tag: <tag>
  ~include: items
  ~limit: 100
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Download jobs, newest first

  - An API key with the `read` scope (any key).

  The list leaves out each job's `items` unless `include=items`.

  Reference: docs/api/data-downloads/listDownloads.md in the repository.
}
