meta {
  name: Delete a dataset and its files
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/v1/datasets/:name
  body: none
  auth: bearer
}

params:path {
  name: <name>
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Delete a dataset and its files

  - An API key with the `admin` scope.
  - This computer only: the Bridge refuses this call from any other address (403 `LOOPBACK_ONLY`).

  This computer only, admin key.

  Reference: docs/api/data-downloads/deleteDataset.md in the repository.
}
