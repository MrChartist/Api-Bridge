meta {
  name: Cancel a job
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/downloads/:downloadId/cancel
  body: none
  auth: bearer
}

params:path {
  downloadId: {{downloadId}}
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Cancel a job

  - An API key with the `read` scope (any key).

  Files of items that were already whole are kept; half-written parts are dropped. A cancelled job cannot be resumed.

  Reference: docs/api/data-downloads/cancelDownload.md in the repository.
}
